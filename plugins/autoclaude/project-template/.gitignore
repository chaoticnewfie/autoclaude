# AutoClaude runtime state. Never committed.
.autoclaude/

# Secrets an AutoClaude run generates, one file each. Never committed.
secrets/

# Security findings and other notes that must not be published. Never committed.
docs/private/

# Dependencies and build output
node_modules/
dist/

# Environment files: only the example is tracked
.env
.env.*
!.env.example

# Logs
*.log

# Test and coverage output. Everything the app, the dev server or the tests write inside the
# project belongs here (a local database file, uploads): the gate commits with `git add -A`.
coverage/
test-results/
playwright-report/

# OS junk
.DS_Store
Thumbs.db
desktop.ini
