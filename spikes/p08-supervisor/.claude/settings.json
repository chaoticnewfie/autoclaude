    "SessionEnd":        [ { "hooks": [ { "type": "command", "command": "node \"C:/AutoClaude/spikes/p08-supervisor/hooklog.js\" SessionEnd" } ] } ],
    "Notification":      [ { "hooks": [ { "type": "command", "command": "node \"C:/AutoClaude/spikes/p08-supervisor/hooklog.js\" Notification" } ] } ],
