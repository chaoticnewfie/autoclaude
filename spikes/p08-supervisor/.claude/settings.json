    "Stop":              [ { "hooks": [ { "type": "command", "command": "node \"C:/AutoClaude/spikes/p08-supervisor/hooklog.js\" Stop" } ] } ],
    "PostToolUse":       [ { "hooks": [ { "type": "command", "command": "node \"C:/AutoClaude/spikes/p08-supervisor/hooklog.js\" PostToolUse" } ] } ],
